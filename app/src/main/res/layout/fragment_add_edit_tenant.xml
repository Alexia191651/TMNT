<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent" android:layout_height="match_parent"
              android:orientation="vertical" android:padding="24dp">

    <EditText android:id="@+id/nameEditText" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:minHeight="48dp"
              android:hint="Tenant name" android:inputType="textPersonName" />
    <EditText android:id="@+id/phoneEditText" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:minHeight="48dp"
              android:hint="Phone number" android:inputType="phone" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/unitEditText" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:minHeight="48dp"
              android:hint="Unit / house number" android:inputType="text" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/rentEditText" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:minHeight="48dp"
              android:hint="Monthly rent (KSh)" android:inputType="numberDecimal" android:layout_marginTop="12dp" />
    <Button android:id="@+id/saveButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="SAVE" android:layout_marginTop="24dp" />
</LinearLayout>