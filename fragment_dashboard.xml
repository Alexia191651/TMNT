<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_bg">

    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/overviewTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Here is an overview of your property"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp" />

    <!-- Stat Cards Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tenantCountTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tenants\n0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:padding="16dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/totalRentTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total rent\nKSh 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:padding="16dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Water & Electricity Maintenance Stat Badge -->
    <TextView
        android:id="@+id/pendingMaintenanceTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛠 Water &amp; Electricity Issues: 0 Pending"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/card_bg"
        android:elevation="2dp"
        android:layout_marginTop="12dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/addTenantButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ ADD TENANT"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@color/white"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/viewTenantsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VIEW ALL"
            android:backgroundTint="@color/brand_accent"
            android:textColor="@color/white"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Tenants (Tap to view/edit, long-press to delete)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="20dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentTenantsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/emptyDashboardTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No tenants yet. Click + ADD TENANT to start."
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
